  "dispositions": [
    {
      "id": "call_911",
      "rank": 4,
      "headline": {
        "en": "Call 911 now",
        "zh": "现在就打 911"
      },
      "text": {
        "en": "This could be an emergency. Call 911 or ask someone to call for you, and don't drive yourself. We've stopped the price estimate here.",
        "zh": "这可能是急症。请立即拨打 911 或请身边的人帮你打，不要自己开车。价格估算到此停止。"
      }
    },
    {
      "id": "er_today",
      "rank": 3,
      "headline": {
        "en": "Go to an emergency room now",
        "zh": "现在就去急诊"
      },
      "text": {
        "en": "Don't wait for an appointment. Go to the nearest ER; if you can't get there safely, call 911. We've stopped the price estimate here.",
        "zh": "不要等预约，直接去最近的急诊室；如果无法安全到达，请拨打 911。价格估算到此停止。"
      }
    },
    {
      "id": "seen_today",
      "rank": 2,
      "headline": {
        "en": "Get seen today",
        "zh": "今天就去看医生"
      },
      "text": {
        "en": "Go to urgent care or call your doctor's office today. This needs a clinician to look at it first, so we won't estimate a price for it.",
        "zh": "今天去 urgent care 或打电话给你的医生。这种情况需要先由医生判断，所以我们不做价格估算。"
      }
    },
    {
      "id": "routine",
      "rank": 1,
      "headline": {
        "en": "Book a visit with your doctor",
        "zh": "预约你的医生"
      },
      "text": {
        "en": "Not an emergency, but it goes beyond the minor problems this tool covers. Your doctor should check for other causes first.",
        "zh": "不是急症，但超出了本工具覆盖的小毛病范围。请先让医生排查其他原因。"
      }
    }
  ],
