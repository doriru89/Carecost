#!/bin/sh
if git diff --cached --name-only | grep -q "^data/registries/"; then
    python scripts/generate_frontend_registry.py --check
    if [ $? -ne 0 ]; then
        echo "ERROR: Registry YAML changed but generated files are stale."
        echo "Run: python scripts/generate_frontend_registry.py"
        exit 1
    fi
fi
