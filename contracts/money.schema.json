{
  "$defs": {
    "Method": {
      "description": "How the number in a ``Money`` was obtained.",
      "enum": [
        "stated",
        "derived_pct_x_gross",
        "computed_fee_schedule",
        "estimate_medicare_multiple"
      ],
      "title": "Method",
      "type": "string"
    },
    "PriceBasis": {
      "description": "What the amount *is* (as opposed to how we got it).",
      "enum": [
        "negotiated",
        "gross",
        "discounted_cash",
        "min_negotiated",
        "max_negotiated",
        "median_allowed",
        "fee_schedule",
        "posted_self_pay",
        "estimate"
      ],
      "title": "PriceBasis",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/Method"
        },
        "payer_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whose rate this is (payer_aliases.yaml id) for payer-specific rows (hospital MRF payer rows, TiC); None for fee schedules, cash and chargemaster prices. Lets the quote check that a BCBS receipt only sums BCBS rates.",
          "title": "Payer Id"
        },
        "row_ref": {
          "description": "<source_id>:<sha256[:12]>:<staged row ordinal>",
          "title": "Row Ref",
          "type": "string"
        },
        "source_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's own last_updated_on (ISO).",
          "title": "Source Date"
        },
        "source_file": {
          "description": "Basename only; never an absolute or relative path.",
          "title": "Source File",
          "type": "string"
        },
        "source_id": {
          "description": "Sources registry id. The UI's source chip is derived from this (never stored separately), so a number cannot sit next to another file's chip.",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_kind",
        "source_file",
        "source_sha256",
        "source_date",
        "method",
        "row_ref"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "hospital_mrf",
        "insurer_tic",
        "medicare_pfs",
        "medicare_opps",
        "medicare_asc",
        "masshealth_fs",
        "clinic_posted",
        "chia_rp"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://carecost.local/contracts/money.schema.json",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/PriceBasis"
    },
    "high": {
      "minimum": 0,
      "title": "High",
      "type": "number"
    },
    "kind": {
      "const": "money",
      "default": "money",
      "title": "Kind",
      "type": "string"
    },
    "low": {
      "minimum": 0,
      "title": "Low",
      "type": "number"
    },
    "prov": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "low",
    "high",
    "basis",
    "prov"
  ],
  "title": "Money",
  "type": "object"
}
