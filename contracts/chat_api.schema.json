{
  "$defs": {
    "AiPausedReply": {
      "additionalProperties": false,
      "properties": {
        "browse_prices_available": {
          "const": true,
          "default": true,
          "title": "Browse Prices Available",
          "type": "boolean"
        },
        "kind": {
          "const": "ai_paused",
          "title": "Kind",
          "type": "string"
        },
        "message_key": {
          "enum": [
            "ai.paused_ip_cap",
            "ai.paused_wallet",
            "ai.paused_provider",
            "ai.paused_conversation_cap"
          ],
          "title": "Message Key",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ip_daily_cap",
            "wallet_exhausted",
            "provider_unavailable",
            "conversation_cap"
          ],
          "title": "Reason",
          "type": "string"
        },
        "resumes_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when unknown (wallet / provider)",
          "title": "Resumes At"
        }
      },
      "required": [
        "kind",
        "reason",
        "message_key",
        "resumes_at",
        "browse_prices_available"
      ],
      "title": "AiPausedReply",
      "type": "object"
    },
    "BecauseAnswer": {
      "additionalProperties": false,
      "description": "D33: one of the person's own chip answers that satisfied the path's entry rule. Built by\nthe server from the request, never written by the LLM.",
      "properties": {
        "label": {
          "$ref": "#/$defs/Title",
          "description": "The answer's label, verbatim from questions.yaml"
        },
        "question_id": {
          "pattern": "^Q[0-9]+$",
          "title": "Question Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "value",
        "label"
      ],
      "title": "BecauseAnswer",
      "type": "object"
    },
    "BudgetStatus": {
      "additionalProperties": false,
      "description": "D2 + metrics F2. Per hashed IP per provider day (the reset time zone is provider config:\nGemini resets at midnight Pacific). Dollars and turns both count; whichever hits first pauses.\nThe wallet is the prepaid ceiling (~$10).",
      "properties": {
        "hard_cap_usd": {
          "exclusiveMinimum": 0,
          "title": "Hard Cap Usd",
          "type": "number"
        },
        "resets_at": {
          "format": "date-time",
          "title": "Resets At",
          "type": "string"
        },
        "soft_cap_usd": {
          "exclusiveMinimum": 0,
          "title": "Soft Cap Usd",
          "type": "number"
        },
        "spent_today_usd": {
          "minimum": 0,
          "title": "Spent Today Usd",
          "type": "number"
        },
        "state": {
          "enum": [
            "ok",
            "near_soft_cap",
            "over_soft_cap",
            "paused"
          ],
          "title": "State",
          "type": "string"
        },
        "turn_cap": {
          "description": "Per-IP daily turn cap (a share of the project RPD)",
          "exclusiveMinimum": 0,
          "title": "Turn Cap",
          "type": "integer"
        },
        "turns_today": {
          "description": "LLM turns this IP used today, this one included",
          "minimum": 0,
          "title": "Turns Today",
          "type": "integer"
        },
        "wallet": {
          "enum": [
            "ok",
            "low",
            "exhausted"
          ],
          "title": "Wallet",
          "type": "string"
        }
      },
      "required": [
        "state",
        "soft_cap_usd",
        "hard_cap_usd",
        "spent_today_usd",
        "turns_today",
        "turn_cap",
        "wallet",
        "resets_at"
      ],
      "title": "BudgetStatus",
      "type": "object"
    },
    "CandidatePath": {
      "additionalProperties": false,
      "properties": {
        "because": {
          "description": "D33: why this path, as the person's own answers that matched its entry rule (question order). Empty for ai_ranked: the model's guess has no listed reason.",
          "items": {
            "$ref": "#/$defs/BecauseAnswer"
          },
          "title": "Because",
          "type": "array"
        },
        "match": {
          "description": "entry_matched: the answers satisfy the path's entry rule (deterministic). ai_ranked: the LLM picked it from the catalog.",
          "enum": [
            "entry_matched",
            "ai_ranked"
          ],
          "title": "Match",
          "type": "string"
        },
        "path_id": {
          "pattern": "^[a-z0-9_]+_v[0-9]+$",
          "title": "Path Id",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending_austin",
            "changes_requested",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "path_id",
        "title",
        "match",
        "review_status",
        "because"
      ],
      "title": "CandidatePath",
      "type": "object"
    },
    "CarePathsReply": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidatePath"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "card_ids": {
          "items": {
            "type": "string"
          },
          "title": "Card Ids",
          "type": "array"
        },
        "copy_keys": {
          "description": "D33: not-a-diagnosis + when-to-see-a-doctor (fixed copy, not LLM text)",
          "items": {
            "enum": [
              "copy.not_a_diagnosis",
              "copy.when_to_see_a_doctor"
            ],
            "type": "string"
          },
          "title": "Copy Keys",
          "type": "array"
        },
        "kind": {
          "const": "care_paths",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "understood": {
          "items": {
            "$ref": "#/$defs/InferredAnswer"
          },
          "title": "Understood",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text",
        "understood",
        "candidates",
        "copy_keys",
        "card_ids"
      ],
      "title": "CarePathsReply",
      "type": "object"
    },
    "CashPayment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cash",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CashPayment",
      "type": "object"
    },
    "ChatReply": {
      "oneOf": [
        {
          "$ref": "#/$defs/RedFlagReply"
        },
        {
          "$ref": "#/$defs/ClarifyReply"
        },
        {
          "$ref": "#/$defs/CarePathsReply"
        },
        {
          "$ref": "#/$defs/TextReply"
        },
        {
          "$ref": "#/$defs/LlmInvalidReply"
        },
        {
          "$ref": "#/$defs/AiPausedReply"
        }
      ]
    },
    "ChatRequest": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "description": "Chip answers so far, questions.yaml id -> answer values (client keeps state)",
          "maxProperties": 20,
          "title": "Answers",
          "type": "object"
        },
        "conversation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque, issued by the server on the first reply; None on the first message",
          "title": "Conversation Id"
        },
        "email": {
          "description": "D2: required before AI use, deliberately unverified. The only personal field in any CareCost contract.",
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/Focus"
            },
            {
              "type": "null"
            }
          ],
          "description": "P5: the receipt line the person is asking about, so the server can paste our own sourced text for it into the prompt"
        },
        "history": {
          "description": "P5b: the person's own earlier messages, oldest first. Never assistant turns: a client-forged assistant turn is how the old route was broken.",
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "History",
          "type": "array"
        },
        "locale": {
          "enum": [
            "en",
            "zh"
          ],
          "title": "Locale",
          "type": "string"
        },
        "payment": {
          "discriminator": {
            "mapping": {
              "cash": "#/$defs/CashPayment",
              "insurance": "#/$defs/InsurancePayment",
              "masshealth": "#/$defs/MassHealthPayment",
              "medicare": "#/$defs/MedicarePayment"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InsurancePayment"
            },
            {
              "$ref": "#/$defs/MedicarePayment"
            },
            {
              "$ref": "#/$defs/MassHealthPayment"
            },
            {
              "$ref": "#/$defs/CashPayment"
            }
          ],
          "title": "Payment"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "text",
        "payment",
        "email",
        "answers",
        "history",
        "focus",
        "locale"
      ],
      "title": "ChatRequest",
      "type": "object"
    },
    "ChatResponse": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetStatus"
        },
        "conversation_id": {
          "pattern": "^[A-Za-z0-9_-]{16,64}$",
          "title": "Conversation Id",
          "type": "string"
        },
        "conversation_turn": {
          "description": "The server's count for this conversation",
          "minimum": 1,
          "title": "Conversation Turn",
          "type": "integer"
        },
        "llm_called": {
          "description": "From the LLM client's call meter, never set by the handler. False for red-flag, ai_paused and cached replies",
          "title": "Llm Called",
          "type": "boolean"
        },
        "reply": {
          "discriminator": {
            "mapping": {
              "ai_paused": "#/$defs/AiPausedReply",
              "care_paths": "#/$defs/CarePathsReply",
              "clarify": "#/$defs/ClarifyReply",
              "llm_invalid": "#/$defs/LlmInvalidReply",
              "red_flag": "#/$defs/RedFlagReply",
              "text": "#/$defs/TextReply"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RedFlagReply"
            },
            {
              "$ref": "#/$defs/ClarifyReply"
            },
            {
              "$ref": "#/$defs/CarePathsReply"
            },
            {
              "$ref": "#/$defs/TextReply"
            },
            {
              "$ref": "#/$defs/LlmInvalidReply"
            },
            {
              "$ref": "#/$defs/AiPausedReply"
            }
          ],
          "title": "Reply"
        }
      },
      "required": [
        "conversation_id",
        "reply",
        "budget",
        "llm_called",
        "conversation_turn"
      ],
      "title": "ChatResponse",
      "type": "object"
    },
    "ChipAnswer": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/Title"
        },
        "value": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ChipAnswer",
      "type": "object"
    },
    "ChipQuestion": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/ChipAnswer"
          },
          "minItems": 1,
          "title": "Answers",
          "type": "array"
        },
        "multi": {
          "title": "Multi",
          "type": "boolean"
        },
        "question_id": {
          "pattern": "^Q[0-9]+$",
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/Title"
        }
      },
      "required": [
        "question_id",
        "text",
        "multi",
        "answers"
      ],
      "title": "ChipQuestion",
      "type": "object"
    },
    "ClarifyReply": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "description": "Prices can show from turn one; questions only refine",
          "items": {
            "$ref": "#/$defs/CandidatePath"
          },
          "title": "Candidates",
          "type": "array"
        },
        "card_ids": {
          "description": "questions.yaml card ids",
          "items": {
            "type": "string"
          },
          "title": "Card Ids",
          "type": "array"
        },
        "copy_keys": {
          "description": "D33: not-a-diagnosis + when-to-see-a-doctor, whenever candidates show",
          "items": {
            "enum": [
              "copy.not_a_diagnosis",
              "copy.when_to_see_a_doctor"
            ],
            "type": "string"
          },
          "title": "Copy Keys",
          "type": "array"
        },
        "kind": {
          "const": "clarify",
          "title": "Kind",
          "type": "string"
        },
        "lead_in": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Short assistant sentence before the chips",
          "title": "Lead In"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ChipQuestion"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "understood": {
          "items": {
            "$ref": "#/$defs/InferredAnswer"
          },
          "title": "Understood",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "lead_in",
        "understood",
        "questions",
        "candidates",
        "copy_keys",
        "card_ids"
      ],
      "title": "ClarifyReply",
      "type": "object"
    },
    "Disposition": {
      "description": "redflags.json dispositions",
      "enum": [
        "call_911",
        "crisis_988",
        "er_today",
        "seen_today",
        "routine"
      ],
      "type": "string"
    },
    "Focus": {
      "additionalProperties": false,
      "properties": {
        "care_path_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+_v[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Care Path Id"
        },
        "line_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line Id"
        },
        "site_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Site Id"
        }
      },
      "required": [
        "care_path_id",
        "site_id",
        "line_id"
      ],
      "title": "Focus",
      "type": "object"
    },
    "InferredAnswer": {
      "additionalProperties": false,
      "description": "P5: an answer the model read from the person's own words, shown as a pre-selected chip\n(\"I understood: ... [change]\"). Never the absence of something (no \"none\" values).",
      "properties": {
        "evidence": {
          "description": "Verbatim substring of the person's own text that supports it",
          "maxLength": 80,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "question_id": {
          "pattern": "^Q[0-9]+$",
          "title": "Question Id",
          "type": "string"
        },
        "value": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "value",
        "evidence"
      ],
      "title": "InferredAnswer",
      "type": "object"
    },
    "InsurancePayment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "insurance",
          "title": "Kind",
          "type": "string"
        },
        "network": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional named network inside the product (TiC network id), e.g. hmo_blue",
          "title": "Network"
        },
        "payer_id": {
          "description": "payer_aliases.yaml id, e.g. BCBS_MA",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Payer Id",
          "type": "string"
        },
        "product": {
          "description": "payer_aliases.yaml `products`: HMO, PPO, POS, EPO ...",
          "pattern": "^[A-Z]+$",
          "title": "Product",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "payer_id",
        "product",
        "network"
      ],
      "title": "InsurancePayment",
      "type": "object"
    },
    "LlmInvalidReply": {
      "additionalProperties": false,
      "description": "The model answered but its output failed validation twice (one retry, both charged).",
      "properties": {
        "browse_prices_available": {
          "const": true,
          "default": true,
          "title": "Browse Prices Available",
          "type": "boolean"
        },
        "kind": {
          "const": "llm_invalid",
          "title": "Kind",
          "type": "string"
        },
        "message_key": {
          "const": "ai.output_invalid",
          "title": "Message Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message_key",
        "browse_prices_available"
      ],
      "title": "LlmInvalidReply",
      "type": "object"
    },
    "MassHealthPayment": {
      "additionalProperties": false,
      "description": "MassHealth fee-for-service rates. ACO / MCO plans may pay differently (shown as a note).",
      "properties": {
        "kind": {
          "const": "masshealth",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MassHealthPayment",
      "type": "object"
    },
    "MedicarePayment": {
      "additionalProperties": false,
      "description": "Traditional Medicare (FFS). Medicare Advantage is an InsurancePayment (e.g. HUMANA).",
      "properties": {
        "kind": {
          "const": "medicare",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MedicarePayment",
      "type": "object"
    },
    "Payment": {
      "oneOf": [
        {
          "$ref": "#/$defs/InsurancePayment"
        },
        {
          "$ref": "#/$defs/MedicarePayment"
        },
        {
          "$ref": "#/$defs/MassHealthPayment"
        },
        {
          "$ref": "#/$defs/CashPayment"
        }
      ]
    },
    "RedFlagReply": {
      "additionalProperties": false,
      "description": "Full-page stop (plan §4.1). Copy is copied verbatim from redflags.json `dispositions`.",
      "properties": {
        "disposition": {
          "enum": [
            "call_911",
            "crisis_988",
            "er_today",
            "seen_today",
            "routine"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "escalated_by_llm": {
          "default": false,
          "description": "redflags.combine(): the LLM raised the disposition (one way only)",
          "title": "Escalated By Llm",
          "type": "boolean"
        },
        "flag_ids": {
          "description": "redflags.json flag ids (rf_*); empty only when the LLM raised it",
          "items": {
            "type": "string"
          },
          "title": "Flag Ids",
          "type": "array"
        },
        "headline": {
          "$ref": "#/$defs/Title"
        },
        "kind": {
          "const": "red_flag",
          "title": "Kind",
          "type": "string"
        },
        "prices_withheld": {
          "const": true,
          "default": true,
          "title": "Prices Withheld",
          "type": "boolean"
        },
        "text": {
          "$ref": "#/$defs/Title"
        }
      },
      "required": [
        "kind",
        "disposition",
        "flag_ids",
        "escalated_by_llm",
        "headline",
        "text",
        "prices_withheld"
      ],
      "title": "RedFlagReply",
      "type": "object"
    },
    "ServiceRef": {
      "additionalProperties": false,
      "description": "P5: a catalog service the model points at when no care path fits. The UI quotes it through\nthe manual path with picked_by=assistant: shown, labelled, never summed.",
      "properties": {
        "plain_name": {
          "description": "Filled from the catalog by id, never by the model",
          "title": "Plain Name",
          "type": "string"
        },
        "service_id": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "plain_name"
      ],
      "title": "ServiceRef",
      "type": "object"
    },
    "TextReply": {
      "additionalProperties": false,
      "description": "Anything else: out of scope, 'not covered yet', a follow-up answer. No prices in text.",
      "properties": {
        "card_ids": {
          "items": {
            "type": "string"
          },
          "title": "Card Ids",
          "type": "array"
        },
        "focus_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The receipt line this explains: must be the request's focus",
          "title": "Focus Line Id"
        },
        "glossary_keys": {
          "items": {
            "type": "string"
          },
          "title": "Glossary Keys",
          "type": "array"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceRef"
          },
          "maxItems": 3,
          "title": "Services",
