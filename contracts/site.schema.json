{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "state": {
          "default": "MA",
          "pattern": "^[A-Z]{2}$",
          "title": "State",
          "type": "string"
        },
        "street": {
          "title": "Street",
          "type": "string"
        },
        "zip": {
          "pattern": "^[0-9]{5}$",
          "title": "Zip",
          "type": "string"
        }
      },
      "required": [
        "street",
        "city",
        "zip"
      ],
      "title": "Address",
      "type": "object"
    },
    "BookingOption": {
      "additionalProperties": false,
      "description": "D7: links only. The app never posts to these systems and never scrapes them.",
      "properties": {
        "kind": {
          "enum": [
            "deep_link",
            "iframe_mgb",
            "walk_in",
            "call"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "description": "Button text, e.g. 'Reserve a spot'",
          "title": "Label",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "provider": {
          "enum": [
            "on_my_way",
            "solv",
            "clockwise",
            "zocdoc",
            "mychart_open_scheduling",
            "operator_site",
            "phone",
            "none"
          ],
          "title": "Provider",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "kind",
        "provider",
        "label"
      ],
      "title": "BookingOption",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "geocoded_at": {
          "format": "date",
          "title": "Geocoded At",
          "type": "string"
        },
        "geocoded_by": {
          "enum": [
            "census_batch",
            "operator_page",
            "manual",
            "hospital_registry"
          ],
          "title": "Geocoded By",
          "type": "string"
        },
        "lat": {
          "description": "Greater Boston scope guard",
          "maximum": 43.5,
          "minimum": 41.0,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": -69.5,
          "minimum": -72.5,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon",
        "geocoded_by",
        "geocoded_at"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "Hours": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date",
          "title": "Checked At",
          "type": "string"
        },
        "may_close_early": {
          "default": false,
          "description": "Operator warns hours vary with clinical capacity",
          "title": "May Close Early",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "on_my_way",
            "operator_html",
            "operator_schema_org",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "weekly": {
          "description": "Empty = by appointment / unknown",
          "items": {
            "$ref": "#/$defs/HoursSpan"
          },
          "title": "Weekly",
          "type": "array"
        }
      },
      "required": [
        "source",
        "source_url",
        "checked_at"
      ],
      "title": "Hours",
      "type": "object"
    },
    "HoursSpan": {
      "additionalProperties": false,
      "properties": {
        "closes": {
          "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$",
          "title": "Closes",
          "type": "string"
        },
        "days": {
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "opens": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Opens",
          "type": "string"
        }
      },
      "required": [
        "days",
        "opens",
        "closes"
      ],
      "title": "HoursSpan",
      "type": "object"
    },
    "PortalLink": {
      "additionalProperties": false,
      "description": "D7: the health system's patient portal (MyChart, MGB Patient Gateway). Link only.",
      "properties": {
        "kind": {
          "enum": [
            "mychart",
            "patient_gateway"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "system_id": {
          "description": "e.g. mgb, bilh, bmc",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "System Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "system_id",
        "label",
        "url"
      ],
      "title": "PortalLink",
      "type": "object"
    },
    "PostedCashPrice": {
      "additionalProperties": false,
      "description": "A self-pay price the site posts on its own website (never Solv / MyChart / Zocdoc).\n\nWritten only after Austin approves the weekly price checker's diff.",
      "properties": {
        "add_on_to_visit": {
          "default": false,
          "description": "Site says 'plus the visit price' (Carbon Health X-rays)",
          "title": "Add On To Visit",
          "type": "boolean"
        },
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "checked_at": {
          "format": "date",
          "title": "Checked At",
          "type": "string"
        },
        "codes": {
          "description": "CPT/HCPCS we map it to; empty = no confident mapping",
          "items": {
            "type": "string"
          },
          "title": "Codes",
          "type": "array"
        },
        "final_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "After redirects; checker rejects a redirect",
          "title": "Final Url"
        },
        "includes_provider_fee": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True when the posted price covers the clinician's own fee too; None = unclear",
          "title": "Includes Provider Fee"
        },
        "item_id": {
          "description": "stable within the site, e.g. xray_2_views",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Item Id",
          "type": "string"
        },
        "label": {
          "description": "As the site words it, e.g. 'X-ray, 2 views'",
          "title": "Label",
          "type": "string"
        },
        "page_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the checker's normalized JSON of the price table",
          "title": "Page Sha256"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "label",
        "amount",
        "includes_provider_fee",
        "source_url",
        "checked_at"
      ],
      "title": "PostedCashPrice",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "billing_type": {
          "enum": [
            "office_visit",
            "hospital_outpatient",
            "asc",
            "unknown"
          ],
          "title": "Billing Type",
          "type": "string"
        },
        "billing_type_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL or note that established billing_type",
          "title": "Billing Type Source"
        },
        "booking": {
          "items": {
            "$ref": "#/$defs/BookingOption"
          },
          "title": "Booking",
          "type": "array"
        },
        "cash_prices": {
          "items": {
            "$ref": "#/$defs/PostedCashPrice"
          },
          "title": "Cash Prices",
          "type": "array"
        },
        "coords": {
          "$ref": "#/$defs/Coordinates"
        },
        "hospital_entity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "data/registries/hospitals.yaml id whose price file prices this site (hospital_outpatient sites); None for independent clinics",
          "title": "Hospital Entity Id"
        },
        "hours": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hours"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "listing_checked_at": {
          "format": "date",
          "title": "Listing Checked At",
          "type": "string"
        },
        "listing_status": {
          "enum": [
            "web_verified",
            "multi_registry",
            "registry_only"
          ],
          "title": "Listing Status",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "operator": {
          "description": "Who runs it, e.g. 'BILH', 'AFC franchise', 'Carbon Health'",
          "title": "Operator",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "portal_links": {
          "items": {
            "$ref": "#/$defs/PortalLink"
          },
          "title": "Portal Links",
          "type": "array"
        },
        "service_areas": {
          "items": {
            "enum": [
              "ortho",
              "skin",
              "gi",
              "urgent_care"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Service Areas",
          "type": "array"
        },
        "site_type": {
          "enum": [
            "urgent_care",
            "hospital_outpatient",
            "ortho_walk_in",
            "specialist_office",
            "primary_care_office",
            "imaging_center",
            "ambulatory_surgery_center"
          ],
          "title": "Site Type",
          "type": "string"
        },
        "system_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Health system id (mgb, bilh, bmc ...) if any",
          "title": "System Id"
        },
        "tins": {
          "description": "Billing TINs (9 digits) that price this site in TiC files. Match by TIN, never by name: one AFC franchise bills under several TINs.",
          "items": {
            "type": "string"
          },
          "title": "Tins",
          "type": "array"
        },
        "tins_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the TINs came from (NPPES, TiC match, census row)",
          "title": "Tins Source"
        },
        "type_2_npis": {
          "items": {
            "type": "string"
          },
          "title": "Type 2 Npis",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "site_type",
        "operator",
        "billing_type",
        "address",
        "coords",
        "service_areas",
        "listing_status",
        "listing_checked_at"
      ],
      "title": "Site",
      "type": "object"
    },
    "SitesFile": {
      "additionalProperties": false,
      "description": "``data/sites/sites.yaml``.",
      "properties": {
        "sites": {
          "items": {
            "$ref": "#/$defs/Site"
          },
          "title": "Sites",
          "type": "array"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "sites"
      ],
      "title": "SitesFile",
      "type": "object"
    }
  },
  "$id": "https://carecost.local/contracts/site.schema.json",
  "$ref": "#/$defs/SitesFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SitesFile"
}
